MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=nomina_app-01-dev
# Contraseña de la sesión sellada (mínimo 32 caracteres; se genera sola en dev)
NUXT_SESSION_PASSWORD=change-me-por-una-frase-larga-de-al-menos-32-caracteres
# Google OAuth (opcional): https://console.cloud.google.com/apis/credentials
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Orígenes permitidos para CORS, separados por coma (vacío = solo same-origin)
CORS_ORIGINS=
# Email transaccional (Brevo): https://app.brevo.com/settings/keys/smtp
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-responder@tudominio.com
BREVO_WEBHOOK_SECRET=cambia-este-secreto-para-el-webhook
# URL pública de la app (para enlaces de invitación)
APP_URL=http://localhost:3000
NODE_ENV=development
